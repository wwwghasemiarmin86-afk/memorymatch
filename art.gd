static func _space_ops(i: int) -> Array:
	var o: Array = []
	match i:
		0: # rocket
			o.append(["p", [-0.4, 0.3, -0.85, 0.9, -0.3, 0.6], "#ef5350"])
			o.append(["p", [0.4, 0.3, 0.85, 0.9, 0.3, 0.6], "#ef5350"])
			o.append(["p", [-0.18, 0.8, 0, 1.1, 0.18, 0.8], "#ffa000"])
			o.append(["e", 0, 0, 0.45, 0.85, "#eceff1"])
			o.append(["p", [-0.38, -0.5, 0, -1.05, 0.38, -0.5], "#ef5350"])
			o.append(["c", 0, -0.05, 0.2, "#4fc3f7"])
		1: # saturn
			o.append(["c", 0, 0, 0.55, "#ffb74d"])
			o.append(["c", -0.18, -0.15, 0.1, "#ffffff55"])
			o.append(["eo", 0, 0, 0.98, 0.28, 0.09, "#e6a800"])
		2: # crescent moon
			o.append(["c", 0, 0, 0.8, "#fff59d"])
			o.append(["c", 0.38, -0.15, 0.68, "bg"])
			o.append(["c", -0.5, 0.35, 0.05, "#fbc02d"])
		3: # sun
			var ang := [0.0, 0.785, 1.571, 2.356, 3.1416, 3.927, 4.712, 5.498]
			for a in ang:
				o.append(["l", cos(a) * 0.68, sin(a) * 0.68, cos(a) * 0.98, sin(a) * 0.98, 0.1, "#ffb300"])
			o.append(["c", 0, 0, 0.56, "#ffca28"])
			o.append(["c", -0.18, -0.08, 0.06, "#6d4c41"])
			o.append(["c", 0.18, -0.08, 0.06, "#6d4c41"])
			o.append(["a", 0, 0.05, 0.25, 0.4, 2.74, 0.05, "#6d4c41"])
		4: # earth
			o.append(["c", 0, 0, 0.8, "#29b6f6"])
			o.append(["p", [-0.5, -0.4, -0.1, -0.6, 0.2, -0.3, -0.1, 0.0, -0.45, 0.1], "#66bb6a"])
			o.append(["p", [0.2, 0.15, 0.6, 0.1, 0.55, 0.55, 0.25, 0.6], "#66bb6a"])
			o.append(["c", -0.3, -0.5, 0.07, "#ffffff77"])
		5: # ufo
			o.append(["l", -0.35, 0.3, -0.6, 0.9, 0.06, "#fff59d"])
			o.append(["l", 0.35, 0.3, 0.6, 0.9, 0.06, "#fff59d"])
			o.append(["s", 0, -0.1, 0.42, 3.1416, 6.2832, "#80deea"])
			o.append(["e", 0, 0, 0.95, 0.28, "#90a4ae"])
			o.append(["c", -0.5, 0.03, 0.07, "#fff176"])
			o.append(["c", 0, 0.08, 0.07, "#fff176"])
			o.append(["c", 0.5, 0.03, 0.07, "#fff176"])
		6: # star
			var pts: Array = []
			for j in 10:
				var rad: float = 1.0 if j % 2 == 0 else 0.45
				var a: float = -PI / 2.0 + TAU * float(j) / 10.0
				pts.append(cos(a) * rad)
				pts.append(sin(a) * rad + 0.05)
			o.append(["p", pts, "#ffd54f"])
		7: # comet
			o.append(["p", [-0.9, -0.9, 0.65, 0.05, 0.05, 0.65], "#81d4fa"])
			o.append(["c", 0.35, 0.35, 0.42, "#ffd54f"])
			o.append(["c", 0.25, 0.25, 0.1, "#ffffff77"])
		8: # mars
			o.append(["c", 0, 0, 0.8, "#e64a19"])
			o.append(["c", -0.3, -0.2, 0.18, "#bf360c"])
			o.append(["c", 0.3, 0.2, 0.22, "#bf360c"])
			o.append(["c", 0.1, -0.45, 0.1, "#bf360c"])
			o.append(["c", -0.25, 0.4, 0.1, "#bf360c"])
		9: # astronaut
			o.append(["c", -0.88, 0.05, 0.12, "#b0bec5"])
