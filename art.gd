			o.append(["e", 0, 0.05, 0.6, 0.46, "#263238"])
			o.append(["e", -0.22, -0.1, 0.18, 0.1, "#ffffff55"])
		10: # alien
			o.append(["l", -0.3, -0.7, -0.5, -1.0, 0.05, "#7cb342"])
			o.append(["l", 0.3, -0.7, 0.5, -1.0, 0.05, "#7cb342"])
			o.append(["c", -0.5, -1.0, 0.08, "#ef5350"])
			o.append(["c", 0.5, -1.0, 0.08, "#ef5350"])
			o.append(["e", 0, 0.05, 0.7, 0.8, "#9ccc65"])
			o.append(["e", -0.3, -0.05, 0.2, 0.3, "#212121"])
			o.append(["e", 0.3, -0.05, 0.2, 0.3, "#212121"])
			o.append(["a", 0, 0.35, 0.18, 0.4, 2.74, 0.05, "#33691e"])
		_: # galaxy
			o.append(["a", 0, 0, 0.3, 0, 5.0, 0.13, "#ba68c8"])
			o.append(["a", 0, 0, 0.55, 1.0, 6.0, 0.13, "#7e57c2"])
			o.append(["a", 0, 0, 0.82, 2.0, 7.0, 0.13, "#5c6bc0"])
			o.append(["c", 0, 0, 0.14, "#fbc02d"])
	return o

# ---------------------------------------------------------------
static func _col(s, bg: Color) -> Color:
	if typeof(s) == TYPE_STRING and s == "bg":
		return bg
	return Color(s)

static func _ell(c: Vector2, rx: float, ry: float) -> PackedVector2Array:
	var pts := PackedVector2Array()
	for i in 28:
		var a: float = TAU * float(i) / 28.0
		pts.append(c + Vector2(cos(a) * rx, sin(a) * ry))
	return pts

static func draw_item(ci: CanvasItem, t: int, i: int, c: Vector2, r: float, bg: Color) -> void:
	var key: int = t * 100 + i
	if not _cache.has(key):
		_cache[key] = _build(t, i)
	var ops: Array = _cache[key]
	var k: float = r * 1.25
	for op in ops:
		var kind: String = op[0]
		if kind == "c":
			ci.draw_circle(c + Vector2(op[1], op[2]) * k, float(op[3]) * k, _col(op[4], bg))
		elif kind == "e":
			ci.draw_colored_polygon(_ell(c + Vector2(op[1], op[2]) * k, float(op[3]) * k, float(op[4]) * k), _col(op[5], bg))
		elif kind == "r":
			ci.draw_rect(Rect2(c + Vector2(op[1], op[2]) * k, Vector2(op[3], op[4]) * k), _col(op[5], bg))
		elif kind == "p":
			var flat: Array = op[1]
			var pts := PackedVector2Array()
			for j in range(0, flat.size(), 2):
				pts.append(c + Vector2(flat[j], flat[j + 1]) * k)
			ci.draw_colored_polygon(pts, _col(op[2], bg))
		elif kind == "l":
			ci.draw_line(c + Vector2(op[1], op[2]) * k, c + Vector2(op[3], op[4]) * k, _col(op[6], bg), float(op[5]) * k, true)
		elif kind == "a":
			ci.draw_arc(c + Vector2(op[1], op[2]) * k, float(op[3]) * k, float(op[4]), float(op[5]), 32, _col(op[7], bg), float(op[6]) * k, true)
		elif kind == "o":
			ci.draw_arc(c + Vector2(op[1], op[2]) * k, float(op[3]) * k, 0.0, TAU, 40, _col(op[5], bg), float(op[4]) * k, true)
		elif kind == "s":
			var ctr: Vector2 = c + Vector2(op[1], op[2]) * k
			var rad: float = float(op[3]) * k
			var a0: float = float(op[4])
			var a1: float = float(op[5])
			var sp := PackedVector2Array()
			sp.append(ctr)
			for j in 21:
				var a: float = a0 + (a1 - a0) * float(j) / 20.0
				sp.append(ctr + Vector2(cos(a), sin(a)) * rad)
			ci.draw_colored_polygon(sp, _col(op[6], bg))
		elif kind == "eo":
			var ep := _ell(c + Vector2(op[1], op[2]) * k, float(op[3]) * k, float(op[4]) * k)
			ep.append(ep[0])
			ci.draw_polyline(ep, _col(op[6], bg), float(op[5]) * k, true)
