# ---------------------------------------------------------------
static func _build(t: int, i: int) -> Array:
	match t:
		0:
			return FRUITS[i]
		1:
			return _player_ops(i)
		2:
			return _animal_ops(i)
		3:
			return SWEETS[i]
		_:
			return _space_ops(i)

static func _player_ops(i: int) -> Array:
	var p: Array = PLAYERS[i]
	var skin: String = p[0]
	var hair: String = p[1]
	var style: int = p[2]
	var jersey: String = p[3]
	var trim: String = p[4]
	var beard: bool = p[5]
	var band: String = p[6]
	var o: Array = []
	if style == 1:
		o.append(["c", 0, -0.45, 0.8, hair])
	elif style == 4:
		o.append(["e", 0, -0.05, 0.7, 0.8, hair])
	o.append(["e", 0, 0.78, 0.85, 0.45, jersey])
	o.append(["p", [-0.25, 0.36, 0.25, 0.36, 0, 0.64], trim])
	o.append(["c", -0.56, -0.2, 0.11, skin])
	o.append(["c", 0.56, -0.2, 0.11, skin])
	o.append(["c", 0, -0.25, 0.56, skin])
	if beard:
		o.append(["s", 0, -0.25, 0.56, 0.35, 2.79, hair])
	if style == 0:
		o.append(["s", 0, -0.25, 0.6, 3.1416, 6.2832, hair])
	elif style == 2:
		o.append(["p", [-0.14, -0.72, -0.1, -1.05, 0.1, -1.05, 0.14, -0.72], hair])
	elif style == 5:
		o.append(["c", -0.35, -0.7, 0.2, hair])
		o.append(["c", 0, -0.82, 0.24, hair])
		o.append(["c", 0.35, -0.7, 0.2, hair])
	if band != "":
		o.append(["r", -0.56, -0.58, 1.12, 0.11, band])
	o.append(["c", -0.22, -0.28, 0.07, "#222222"])
	o.append(["c", 0.22, -0.28, 0.07, "#222222"])
	o.append(["a", 0, -0.2, 0.24, 0.5, 2.64, 0.05, "#ffd7d7" if beard else "#7a2d2d"])
	return o

static func _eyes(o: Array, dx: float, y: float, r: float) -> void:
	o.append(["c", -dx, y, r, "#212121"])
	o.append(["c", dx, y, r, "#212121"])
	o.append(["c", -dx + r * 0.3, y - r * 0.3, r * 0.3, "#ffffff"])
	o.append(["c", dx + r * 0.3, y - r * 0.3, r * 0.3, "#ffffff"])

